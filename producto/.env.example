# ---- Obligatorias ----
# Postgres (Neon). Vercel las rellena solas al conectar Neon desde la pestaña Storage.
DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require
# Conexión directa (sin pooler) para las migraciones. Opcional: si falta se usa DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Secreto largo y aleatorio para firmar y cifrar (sesiones, capa anónima). Genera uno con: openssl rand -hex 32
AUTH_SECRET=
# URL pública de la app, sin barra final
APP_URL=https://app.restoraapp.app

# ---- Lectura de albaranes (OCR) con la API de Claude ----
ANTHROPIC_API_KEY=
# Modelo por defecto y modelo de repaso cuando la lectura sale dudosa
OCR_MODEL=claude-sonnet-5
OCR_ESCALATE_MODEL=claude-opus-5
# "anthropic" (real) o "mock" (datos de ejemplo, solo para pruebas)
OCR_PROVIDER=anthropic

# ---- Archivos (albaranes, fotos de platos) ----
# Vercel Blob: se rellena solo al crear un Blob store en Storage. Sin él se guardan en disco (solo desarrollo).
BLOB_READ_WRITE_TOKEN=

# ---- Email (verificación, contraseñas, invitaciones) ----
RESEND_API_KEY=
EMAIL_FROM=RESTORA <hola@restoraapp.app>
# "resend" en producción; "dev" guarda los correos en la base y los muestra en /dev/correo
EMAIL_PROVIDER=resend

# ---- Cobros (opcional al principio) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=14
