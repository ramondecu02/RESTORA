# ---- Obligatorias ----
# Postgres (Neon). Vercel las rellena solas al conectar Neon desde la pestaña Storage.
DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require
# Conexión directa (sin pooler) para las migraciones. Opcional: si falta se usa DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Secreto largo y aleatorio para firmar y cifrar (sesiones, capa anónima). Genera uno con: openssl rand -hex 32
AUTH_SECRET=
# URL pública de la app, sin barra final
APP_URL=https://app.restoraapp.app

# ---- Lectura de albaranes (OCR) con la API de Claude ----
ANTHROPIC_API_KEY=
# Modelo por defecto y modelo de repaso cuando la lectura sale dudosa
OCR_MODEL=claude-sonnet-5
OCR_ESCALATE_MODEL=claude-opus-5
# "anthropic" (real) o "mock" (datos de ejemplo, solo para pruebas). En producción, sin clave, la lectura
# queda desactivada (nunca se inventan datos); los documentos de ejemplo se leen siempre sin gastar.
OCR_PROVIDER=anthropic
# Esfuerzo de la primera lectura: low (por defecto), medium o high. El repaso usa medium.
OCR_EFFORT=low
# Precio por millón de tokens para modelos que no estén en la tabla interna (solo para registrar el coste)
OCR_PRICE_IN=
OCR_PRICE_OUT=

# ---- Archivos (albaranes, fotos de platos) ----
# Vercel Blob (store privado): se rellena solo al conectarlo en Storage. La conexión actual pone BLOB_STORE_ID
# (autenticación OIDC); la antigua, BLOB_READ_WRITE_TOKEN. Sin ninguno se guardan en disco (solo desarrollo).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ---- Email (verificación, contraseñas, invitaciones) ----
RESEND_API_KEY=
# Sin EMAIL_FROM se usa RESTORA <onboarding@resend.dev>, que solo envía al email de tu cuenta de Resend.
# Con el dominio verificado en Resend: EMAIL_FROM=RESTORA <hola@restoraapp.app>
EMAIL_FROM=
# "resend" (lo que se usa si hay RESEND_API_KEY) o "dev": guarda los correos en la base y los muestra en /dev/correo
EMAIL_PROVIDER=

# ---- Cobros (opcional al principio) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Días de prueba de cada negocio nuevo (90 si no se indica)
TRIAL_DAYS=

# ---- Otras ----
# Conexiones por instancia al Postgres (con el pooler de Neon, 5 va bien)
PG_POOL_MAX=5
# Solo para una instalación de pruebas sin correo real: muestra /dev/correo también en producción
ALLOW_DEV_MAILBOX=
