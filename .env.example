# --- Database (PostgreSQL) ---
# Vercel Postgres / Supabase / Neon, or the bundled docker-compose for local dev.
DATABASE_URL="docker compose up -d"

# --- Admin panel (single user) — /<locale>/admin ---
ADMIN_EMAIL="hola@restoraapp.com"
ADMIN_PASSWORD="restora2026!"

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="openssl rand -base64 32"

# --- Public site URL (metadata / OpenGraph). Optional in development. ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
