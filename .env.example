# Plantilla de variables de entorno. NO pongas aquí valores reales:
# este archivo se sube al repositorio. Copia a .env (ignorado por git) y
# rellena tus valores; en Vercel usa Settings → Environment Variables.

# --- Database (PostgreSQL) ---
# Cadena de conexión real (Vercel Postgres / Supabase / Neon, o docker local).
# Local con el docker-compose incluido:
DATABASE_URL="postgresql://restora:restora@localhost:5432/restora?schema=public"

# --- Admin panel (single user) — /<locale>/admin ---
ADMIN_EMAIL="hola@restoraapp.com"
ADMIN_PASSWORD="change-me"

# Secreto para firmar la cookie de sesión. Pega una cadena aleatoria (no este texto).
# Genérala ejecutando:  openssl rand -base64 32
AUTH_SECRET="please-generate-a-long-random-secret"

# --- Public site URL (metadata / OpenGraph). Opcional en desarrollo. ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
